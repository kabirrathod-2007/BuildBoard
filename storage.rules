rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product media uploads: covers, gallery screenshots, demo videos
    match /products/{userId}/{allPaths=**} {
      // Public read access so testers and visitors across any device can load product assets
      allow read: if true;

      // Authenticated creators can upload to their own user-scoped directory
      // Strict size limits: images <= 10MB, videos <= 50MB
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (
                     (request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024) ||
                     (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024)
                   );
    }
  }
}
