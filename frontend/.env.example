# BuildBoard Frontend Environment Configuration (Example)
# In production, configure these in your CI/CD or hosting provider (Vercel, Firebase Hosting, Netlify).

# Firebase Web App Configuration
# Note: Restrict this API key in Google Cloud Console > APIs & Services > Credentials
# Application restriction: HTTP referrers (e.g., https://buildboard.yourdomain.com/*)
# API restriction: Identity Toolkit API (Firebase Authentication)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend API Endpoint (HTTPS in production, no trailing slash)
VITE_API_URL=https://api.buildboard.yourdomain.com
