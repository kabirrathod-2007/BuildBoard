# BuildBoard Backend Environment Configuration (Example)
# DO NOT commit real secrets or credentials into version control.

# Server & Runtime Environment
PORT=3001
NODE_ENV=production
# Comma-separated list of allowed production client origins (no trailing slashes, no wildcards)
FRONTEND_ORIGIN=https://buildboard.yourdomain.com

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account key file (keep outside repository with 0600 file permissions)
# Alternatively, in GCP / Cloud Run environments, omit this to use Workload Identity / Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# MySQL Database Configuration (Dedicated non-root application user)
# Minimum required privileges for runtime API: SELECT, INSERT, UPDATE, DELETE on buildboard.*
# DDL privileges (CREATE, ALTER, DROP) are strictly denied to this account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=buildboard_api_user
DB_PASSWORD=your_secure_db_password
DB_NAME=buildboard

# Dedicated Migration / Schema Runner Configuration (Required in staging/production)
# Migration execution requires administrative DDL privileges (CREATE, ALTER, DROP, INDEX).
# Never use these credentials for the runtime API service.
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=3306
MIGRATION_DB_USER=buildboard_migrator
MIGRATION_DB_PASSWORD=your_secure_migration_password
MIGRATION_DB_NAME=buildboard
